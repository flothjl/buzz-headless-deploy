# Remote Buzz agent runtime settings.
#
# This file contains secrets. Keep the real `config/agent.env` at mode 0600 and
# never commit it. During installation it becomes the root-owned, mode-0600
# `/etc/buzz-agents/<agent>.env`.
#
# The remote file is read by systemd as an EnvironmentFile, not executed as a
# shell script. Put comments on their own lines. Quote values containing spaces;
# single quotes are convenient for JSON such as BUZZ_AUTH_TAG.

# ---------------------------------------------------------------------------
# Relay and identity (required)
# ---------------------------------------------------------------------------

# Public relay WebSocket URL. Use `wss://` when TLS terminates at Caddy or
# another reverse proxy. The URL must identify the same community/host to which
# the human clients connect.
BUZZ_RELAY_URL=wss://buzz.example.com

# The agent's Nostr secret key: either `nsec1...` or exactly 64 hex characters.
# Give every visible agent its own identity. Never use your human private key or
# BUZZ_RELAY_PRIVATE_KEY here.
#
# The relay container can create a keypair with:
#   docker compose exec relay /usr/local/bin/buzz-admin generate-key
#
# Save the printed secret here. The printed public key is safe to use for relay
# and channel membership. Treat the secret as a password and back it up.
BUZZ_PRIVATE_KEY=nsec1CHANGE_ME

# BUZZ_REQUIRE_AUTH_TOKEN=true on the relay does NOT add another token to this
# file. buzz-acp signs WebSocket NIP-42 and HTTP NIP-98 authentication with
# BUZZ_PRIVATE_KEY automatically.
#
# Other independent relay gates may still apply:
#   BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
#     - add the agent pubkey directly with `buzz-admin add-member`, OR
#     - use a valid BUZZ_AUTH_TAG when BUZZ_ALLOW_NIP_OA_AUTH=true and the
#       attesting owner is already a relay member.
#   BUZZ_PUBKEY_ALLOWLIST=true
#     - the agent pubkey must also be in the relay's pubkey allowlist.
#
# Relay membership and channel membership are separate. Add the identity to
# each Buzz channel in which it should receive mentions.

# Optional NIP-OA owner attestation. This JSON tag is signed by the human owner
# for this exact agent pubkey. It lets a closed relay admit the agent through an
# existing owner membership when BUZZ_ALLOW_NIP_OA_AUTH=true, records the
# owner/agent relationship, and takes precedence over BUZZ_ACP_AGENT_OWNER.
#
# It is not an API key and cannot be invented from the public keys. Omit it when
# the agent is admitted as a direct relay member and no owner attestation exists.
# BUZZ_AUTH_TAG='["auth","OWNER_HEX","","SIGNATURE_HEX"]'

# ---------------------------------------------------------------------------
# Who may invoke the agent
# ---------------------------------------------------------------------------

# Owner's 64-character public key (never an nsec). Used when BUZZ_AUTH_TAG is
# absent and by the owner-aware inbound author gate. Keep this explicit for a
# direct-member agent. When a valid BUZZ_AUTH_TAG is present, the verified owner
# encoded in that tag takes precedence.
BUZZ_ACP_AGENT_OWNER=CHANGE_ME_OWNER_64_HEX

# Inbound author policy:
#   owner-only - only the owner
#   allowlist  - owner plus BUZZ_ACP_RESPOND_TO_ALLOWLIST
#   anyone     - any author whose event otherwise matches the subscription
#   nobody     - no inbound events; useful only for proactive/heartbeat agents
# For a private household agent, `allowlist` is the recommended choice.
BUZZ_ACP_RESPOND_TO=allowlist

# Comma-separated 64-character public keys, with no spaces. The owner is always
# included implicitly, so list your wife's pubkey here (and any other trusted
# household identities), not the owner's key.
BUZZ_ACP_RESPOND_TO_ALLOWLIST=CHANGE_ME_WIFE_64_HEX

# Optional deployment guard: restrict which response modes this env file is
# allowed to select. This prevents an accidental edit from broadening access to
# `anyone`. The service refuses to start if BUZZ_ACP_RESPOND_TO is not listed.
BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only,allowlist

# ---------------------------------------------------------------------------
# Agent behavior and subscriptions
# ---------------------------------------------------------------------------

# Human-readable name forwarded to Buzz tooling. This does not create or update
# the agent's relay profile by itself; keep it aligned with the displayed name
# you configure in Buzz.
BUZZ_ACP_DISPLAY_NAME="House Agent"

# Number of parallel ACP/LLM subprocesses behind this one Nostr identity.
# Valid range: 1-32. Increasing this improves concurrency but also increases
# possible model spend and tool activity; it does not create more identities.
BUZZ_ACP_AGENTS=1

# Subscription strategy:
#   mentions - receive events that explicitly p-tag this agent (recommended)
#   all      - receive all matching events in joined channels; the author gate
#              still applies, but this can be noisy and expensive
#   config   - load per-channel filters from BUZZ_ACP_CONFIG
BUZZ_ACP_SUBSCRIBE=mentions

# Optional comma-separated channel UUID restriction. Omit to discover channels
# from the agent's relay memberships. This does not grant channel access.
# BUZZ_ACP_CHANNELS=11111111-1111-1111-1111-111111111111

# Optional comma-separated Nostr event-kind restriction. Omit to use the
# harness defaults. Only set this when you understand the community's kinds.
# BUZZ_ACP_KINDS=9,45001,45003

# Maximum prior thread/DM messages added to each prompt. Valid range: 0-100;
# 0 disables automatic context lookup. More context increases token usage.
BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=12

# New mention behavior while a turn is already running:
#   steer           - restart with the new message framed as added direction
#   queue           - finish the current turn, then process the new message
#   interrupt       - restart with the new message superseding the old request
#   owner-interrupt - interrupt only for messages from the owner
# `steer`, `interrupt`, and `owner-interrupt` require BUZZ_ACP_DEDUP=queue.
BUZZ_ACP_MULTIPLE_EVENT_HANDLING=steer
BUZZ_ACP_DEDUP=queue

# Optional custom persona/system instructions. For long prompts, deploy a
# root-readable file separately and use BUZZ_ACP_SYSTEM_PROMPT_FILE instead.
# Do not set both variables.
# BUZZ_ACP_SYSTEM_PROMPT="You are our private household assistant."
# BUZZ_ACP_SYSTEM_PROMPT_FILE=/etc/buzz-agents/house-agent.prompt

# Turn safety limits. Idle timeout resets whenever the agent produces stdout;
# the maximum duration is an absolute wall-clock cap. Defaults are 900 and 7200.
# BUZZ_ACP_IDLE_TIMEOUT=900
# BUZZ_ACP_MAX_TURN_DURATION=7200

# Memory injection, online presence, and typing indicators are enabled by
# default. These optional switches disable them independently.
# BUZZ_ACP_NO_MEMORY=true
# BUZZ_ACP_NO_PRESENCE=true
# BUZZ_ACP_NO_TYPING=true

# ---------------------------------------------------------------------------
# Bundled buzz-agent model provider
# ---------------------------------------------------------------------------

# Exactly one provider must be selected. Supported values include `openai`
# (`openai-compat` is an alias), `anthropic`, `databricks`, and
# `databricks-v2`. The examples below cover OpenAI-compatible and Anthropic.
BUZZ_AGENT_PROVIDER=openai

# OpenAI or an OpenAI-compatible endpoint. Official OpenAI normally uses the
# values below. For Ollama, vLLM, OpenRouter, or another gateway, change the
# base URL, API selection, key, and model to values supported by that service.
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1

# API shape: `auto`, `chat`, or `responses`.
# `auto` selects Responses for official *.openai.com endpoints and Chat
# Completions for other endpoints. Use an explicit value when your gateway
# supports only one API shape.
OPENAI_COMPAT_API=responses

# Provider credential and provider-specific model ID. Prefer a dedicated key
# with an appropriate project budget/rate limit. Do not quote unless the value
# contains characters that require it.
OPENAI_COMPAT_API_KEY=CHANGE_ME
OPENAI_COMPAT_MODEL=CHANGE_ME

# Optional cross-provider model override. When set, this wins over
# OPENAI_COMPAT_MODEL or ANTHROPIC_MODEL.
# BUZZ_AGENT_MODEL=CHANGE_ME

# Optional reasoning effort. Provider/model support varies.
# OpenAI-family accepted values: none, minimal, low, medium, high, xhigh, max.
# Anthropic accepts low, medium, high, xhigh, or max and may clamp unsupported
# levels for a particular model.
# BUZZ_AGENT_THINKING_EFFORT=medium

# Optional bundled-agent resource controls and their defaults.
# BUZZ_AGENT_MAX_OUTPUT_TOKENS=32768
# BUZZ_AGENT_LLM_TIMEOUT_SECS=240
# BUZZ_AGENT_TOOL_TIMEOUT_SECS=660
# BUZZ_AGENT_MAX_PARALLEL_TOOLS=8

# Anthropic alternative: comment out/remove the active OpenAI block above and
# use these values instead. ANTHROPIC_BASE_URL and ANTHROPIC_API_VERSION usually
# do not need to be set for the public Anthropic API.
# BUZZ_AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=CHANGE_ME
# ANTHROPIC_MODEL=CHANGE_ME
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_VERSION=2023-06-01

# ---------------------------------------------------------------------------
# Values managed by the installer
# ---------------------------------------------------------------------------

# Do not set these here. The remote installer removes any supplied values and
# appends authoritative paths for the selected Sprig release and agent name:
#   BUZZ_ACP_AGENT_COMMAND=/opt/buzz-sprig/current/buzz-agent
#   BUZZ_ACP_MCP_COMMAND=/opt/buzz-sprig/current/buzz-dev-mcp
#   AGENT_CWD=/srv/buzz-agents/<agent>
#
# buzz-dev-mcp can run shell and file-edit tools as this instance's SERVICE_USER.
# Treat channel content as untrusted input, keep SERVICE_USER unique across
# trust boundaries, and only place intended data in the working directory.
