# Local deployment settings.
#
# This file is sourced by Bash on the machine from which you run
# `./buzz-sprig-deploy`. It is not copied to the server. Quote values containing
# spaces or shell-special characters. Do not put untrusted shell text here.

# SSH host name or IP address of the Linux machine. Do not include a user,
# protocol, or port (use DEPLOY_USER and DEPLOY_PORT below).
DEPLOY_HOST=home-server.local

# Existing remote login account. It must support key-based/non-interactive SSH.
# With DEPLOY_USE_SUDO=true it must also have passwordless sudo.
DEPLOY_USER=deploy

# SSH port, from 1 through 65535.
DEPLOY_PORT=22

# Optional local path to a private SSH key. Leave empty to use ssh-agent and
# OpenSSH's normal key discovery. `~/...` and project-relative paths work.
# This key stays on the local machine and is never copied to the server.
DEPLOY_IDENTITY_FILE=

# How privileged remote installation commands are run:
#   true  - execute them with `sudo -n`; fails instead of prompting for a password
#   false - execute them directly; DEPLOY_USER must already be root
# Accepted boolean spellings: true/false, 1/0, yes/no, on/off.
DEPLOY_USE_SUDO=true

# Name of this agent instance. It becomes:
#   systemd service: buzz-agent@house-agent.service
#   environment:     /etc/buzz-agents/house-agent.env
#   working folder:  /srv/buzz-agents/house-agent
# Start with a lowercase letter or digit; remaining characters may also include
# `_`, `.`, and `-`. Use a unique name for each identity on the same server.
AGENT_NAME=house-agent

# Dedicated Linux account that runs Sprig and all model-requested tools.
# Leave empty to derive `buzz-<AGENT_NAME>` (dots become dashes), which gives
# each agent a separate Unix identity by default. The installer creates it as a
# non-login system account. `root`, UID 0 accounts, and names over 32 characters
# are rejected. Do not use your personal desktop account.
SERVICE_USER=

# Sharing a Unix user allows agents to inspect one another's processes,
# workspaces, and environment secrets. Keep this false unless the instances are
# intentionally in the same trust boundary. A duplicate user is rejected.
ALLOW_SHARED_SERVICE_USER=false

# Sprig release selection:
#   rolling - follow the latest rolling Sprig prerelease on every install
#   0.3.0   - pin the sprig-v0.3.0 GitHub release (example)
# At present the official project publishes Sprig as a rolling prerelease.
SPRIG_VERSION=rolling

# Required trust pin for the exact Sprig archive expected on the target
# architecture. Copy the first field from the appropriate published checksum
# only after reviewing the release:
#
# x86-64:
#   curl -fsSL https://github.com/block/buzz/releases/download/sprig-latest/sprig-x86_64-unknown-linux-musl.tar.gz.sha256
# ARM64:
#   curl -fsSL https://github.com/block/buzz/releases/download/sprig-latest/sprig-aarch64-unknown-linux-musl.tar.gz.sha256
#
# The installer requires the downloaded release checksum and archive to match
# this locally pinned value. Updating rolling Sprig is therefore an explicit
# change: review the release, update this pin, then run install again.
SPRIG_SHA256=CHANGE_ME_64_HEX

# Whether `install` should enable the systemd unit for automatic boot startup.
# If false, an already-enabled service is left enabled; use `disable` explicitly
# when you want to disable and stop an existing service.
ENABLE_ON_INSTALL=true

# Whether `install` should start the service immediately. If it is already
# active, it is restarted only when the binary, env file, or unit changed.
# Set false to stage an update without starting/restarting the agent.
START_ON_INSTALL=true

# Number of historical journal lines shown before `logs` begins following.
# Use 0 to follow only new output. Press Ctrl-C to stop following.
DEPLOY_LOG_LINES=100
